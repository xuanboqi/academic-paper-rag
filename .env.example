# Copy this file to .env and adjust it for your Docker PostgreSQL container.
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:15433/literature_rag

# Put the downloaded Qwen3 embedding model in ./models/Qwen3-Embedding-0.6B.
EMBEDDING_MODEL=./models/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cuda
EMBEDDING_TRUST_REMOTE_CODE=true
EMBEDDING_HALF_PRECISION=true
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_QUERY_INSTRUCTION=Given a question, retrieve relevant academic paper passages that answer the question.

# DeepSeek V4 is used only after retrieval, to generate the final answer.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Default data directory.
DATA_DIR=Database

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
BATCH_SIZE=4
TOP_K=8

# Local vision-language model for multimodal paper parsing.
VISION_PROVIDER=local_qwen25_vl
VISION_MODEL=./models/Qwen2.5-VL-3B-Instruct
VISION_DEVICE=cuda
VISION_MAX_NEW_TOKENS=256
VISION_MIN_PIXELS=200704
VISION_MAX_PIXELS=1003520
MULTIMODAL_IMAGE_DIR=./artifacts/multimodal
MULTIMODAL_PAGE_DPI=96
MULTIMODAL_MAX_PAGES_PER_PDF=10
MULTIMODAL_MAX_CANDIDATE_PAGES=3
MULTIMODAL_ONLY_CANDIDATE_PAGES=true
INCLUDE_MULTIMODAL_RETRIEVAL=true
